// DOESN'T COMPILE
// EDBs
.decl Reachable(method:number)
.decl Assign(to:number, from:number)
.decl AssignHeapAllocation(heap:number, to:number, inmethod:number)
.decl AssignLocal(from:number, to:number, inmethod:number)
.decl AssignCast(type:number, from:number, to:number, inmethod:number)
.decl SupertypeOf(supertype:number, type:number)
.decl HeapAllocation_Type(heap:number, type:number)
.decl StoreArrayIndex(from:number, base:number, inmethod:number)
.decl ComponentType(arrayType:number, componentType:number)
.decl LoadArrayIndex(base:number, to:number, inmethod:number)
.decl Var_Type(var:number, type:number)
.decl LoadInstanceField(base:number, sig:number, to:number, inmethod:number)
.decl StoreInstanceField(from:number, base:number, signature:number, inmethod:number)
.decl LoadStaticField(sig:number, to:number, inmethod:number)
.decl StoreStaticField(from:number, signature:number, inmethod:number)
.decl Instruction_Method(insn:number, inMethod:number)
.decl VirtualMethodInvocation_Base(invocation:number, base:number)
.decl VirtualMethodInvocation_SimpleName(invocation:number, simplename:number)
.decl VirtualMethodInvocation_Descriptor(invocation:number, descriptor:number)
.decl MethodLookup(simplename:number, descriptor:number, type:number, method:number)
.decl ThisVar(method:number, var:number)
.decl SpecialMethodInvocation_Base(invocation:number, base:number)
.decl MethodInvocation_Method(invocation:number, signature:number)
.input Reachable(ID=file, filename="Reachable.csv", delimiter=",")
.input Assign(ID=file, filename="Assign.csv", delimiter=",")
.input AssignHeapAllocation(ID=file, filename="AssignHeapAllocation.csv", delimiter=",")
.input AssignLocal(ID=file, filename="AssignLocal.csv", delimiter=",")
.input AssignCast(ID=file, filename="AssignCast.csv", delimiter=",")
.input SupertypeOf(ID=file, filename="SupertypeOf.csv", delimiter=",")
.input HeapAllocation_Type(ID=file, filename="HeapAllocation_Type.csv", delimiter=",")
.input StoreArrayIndex(ID=file, filename="StoreArrayIndex.csv", delimiter=",")
.input ComponentType(ID=file, filename="ComponentType.csv", delimiter=",")
.input LoadArrayIndex(ID=file, filename="LoadArrayIndex.csv", delimiter=",")
.input Var_Type(ID=file, filename="Var_Type.csv", delimiter=",")
.input LoadInstanceField(ID=file, filename="LoadInstanceField.csv", delimiter=",")
.input StoreInstanceField(ID=file, filename="StoreInstanceField.csv", delimiter=",")
.input LoadStaticField(ID=file, filename="LoadStaticField.csv", delimiter=",")
.input StoreStaticField(ID=file, filename="StoreStaticField.csv", delimiter=",")
.input Instruction_Method(ID=file, filename="Instruction_Method.csv", delimiter=",")
.input VirtualMethodInvocation_Base(ID=file, filename="VirtualMethodInvocation_Base.csv", delimiter=",")
.input VirtualMethodInvocation_SimpleName(ID=file, filename="VirtualMethodInvocation_SimpleName.csv", delimiter=",")
.input VirtualMethodInvocation_Descriptor(ID=file, filename="VirtualMethodInvocation_Descriptor.csv", delimiter=",")
.input MethodLookup(ID=file, filename="MethodLookup.csv", delimiter=",")
.input ThisVar(ID=file, filename="ThisVar.csv", delimiter=",")
.input SpecialMethodInvocation_Base(ID=file, filename="SpecialMethodInvocation_Base.csv", delimiter=",")
.input MethodInvocation_Method(ID=file, filename="MethodInvocation_Method.csv", delimiter=",")

