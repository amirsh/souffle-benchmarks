// EDBs
.decl Reachable(method:number)
.decl Assign(to:number, from:number)
.decl AssignHeapAllocation(heap:number, to:number, inmethod:number)
.decl AssignLocal(from:number, to:number, inmethod:number)
.decl AssignCast(type:number, from:number, to:number, inmethod:number)
.decl SupertypeOf(supertype:number, type:number)
.decl HeapAllocation_Type(heap:number, type:number)
.decl StoreArrayIndex(from:number, base:number, inmethod:number)
.decl ComponentType(arrayType:number, componentType:number)
.decl LoadArrayIndex(base:number, to:number, inmethod:number)
.decl Var_Type(var:number, type:number)
.decl LoadInstanceField(base:number, sig:number, to:number, inmethod:number)
.decl StoreInstanceField(from:number, base:number, signature:number, inmethod:number)
.decl LoadStaticField(sig:number, to:number, inmethod:number)
.decl StoreStaticField(from:number, signature:number, inmethod:number)
.decl Instruction_Method(insn:number, inMethod:number)
.decl VirtualMethodInvocation_Base(invocation:number, base:number)
.decl VirtualMethodInvocation_SimpleName(invocation:number, simplename:number)
.decl VirtualMethodInvocation_Descriptor(invocation:number, descriptor:number)
.decl MethodLookup(simplename:number, descriptor:number, type:number, method:number)
.decl ThisVar(method:number, var:number)
.decl SpecialMethodInvocation_Base(invocation:number, base:number)
.decl MethodInvocation_Method(invocation:number, signature:number)
.input Reachable(IO=file, filename="Reachable.csv", delimiter=",")
.input Assign(IO=file, filename="Assign.csv", delimiter=",")
.input AssignHeapAllocation(IO=file, filename="AssignHeapAllocation.csv", delimiter=",")
.input AssignLocal(IO=file, filename="AssignLocal.csv", delimiter=",")
.input AssignCast(IO=file, filename="AssignCast.csv", delimiter=",")
.input SupertypeOf(IO=file, filename="SupertypeOf.csv", delimiter=",")
.input HeapAllocation_Type(IO=file, filename="HeapAllocation_Type.csv", delimiter=",")
.input StoreArrayIndex(IO=file, filename="StoreArrayIndex.csv", delimiter=",")
.input ComponentType(IO=file, filename="ComponentType.csv", delimiter=",")
.input LoadArrayIndex(IO=file, filename="LoadArrayIndex.csv", delimiter=",")
.input Var_Type(IO=file, filename="Var_Type.csv", delimiter=",")
.input LoadInstanceField(IO=file, filename="LoadInstanceField.csv", delimiter=",")
.input StoreInstanceField(IO=file, filename="StoreInstanceField.csv", delimiter=",")
.input LoadStaticField(IO=file, filename="LoadStaticField.csv", delimiter=",")
.input StoreStaticField(IO=file, filename="StoreStaticField.csv", delimiter=",")
.input Instruction_Method(IO=file, filename="Instruction_Method.csv", delimiter=",")
.input VirtualMethodInvocation_Base(IO=file, filename="VirtualMethodInvocation_Base.csv", delimiter=",")
.input VirtualMethodInvocation_SimpleName(IO=file, filename="VirtualMethodInvocation_SimpleName.csv", delimiter=",")
.input VirtualMethodInvocation_Descriptor(IO=file, filename="VirtualMethodInvocation_Descriptor.csv", delimiter=",")
.input MethodLookup(IO=file, filename="MethodLookup.csv", delimiter=",")
.input ThisVar(IO=file, filename="ThisVar.csv", delimiter=",")
.input SpecialMethodInvocation_Base(IO=file, filename="SpecialMethodInvocation_Base.csv", delimiter=",")
.input MethodInvocation_Method(IO=file, filename="MethodInvocation_Method.csv", delimiter=",")

// IDBs
.decl VarPointsTo(heap:number, var:number)
.decl InstanceFieldPointsTo(heap:number , fld:number, baseheap:number)
.decl StaticFieldPointsTo(heap:number, fld:number)
.decl ArrayIndexPointsTo(baseheap:number, heap:number)

.decl kv0(x0:number, x1:number, x2:number)
.decl k_1(x0:number)
.decl jn2(x0:number, x1:number)
.decl k_3(x0:number, x1:number)
.decl kv4(x0:number, x1:number)
.decl kv5(x0:number, x1:number)
.decl kv6(x0:number, x1:number, x2:number, x3:number)
.decl jn7(x0:number, x1:number, x2:number)
.decl jn8(x0:number, x1:number, x2:number)
.decl jn9(x0:number, x1:number, x2:number)
.decl jn10(x0:number, x1:number)
.decl k_11(x0:number, x1:number)
.decl kv12(x0:number, x1:number)
.decl kv13(x0:number, x1:number)
.decl kv14(x0:number, x1:number)
.decl kv15(x0:number, x1:number)
.decl kv16(x0:number, x1:number)
.decl kv17(x0:number, x1:number, x2:number)
.decl jn18(x0:number, x1:number)
.decl jn19(x0:number, x1:number)
.decl jn20(x0:number, x1:number, x2:number)
.decl jn21(x0:number, x1:number, x2:number, x3:number)
.decl jn22(x0:number, x1:number, x2:number, x3:number)
.decl jn23(x0:number, x1:number, x2:number, x3:number)
.decl jn24(x0:number, x1:number)
.decl kv25(x0:number, x1:number, x2:number, x3:number)
.decl jn26(x0:number, x1:number, x2:number)
.decl jn27(x0:number, x1:number, x2:number)
.decl jn28(x0:number, x1:number, x2:number)
.decl kv29(x0:number, x1:number, x2:number)
.decl kv30(x0:number, x1:number, x2:number, x3:number)
.decl jn31(x0:number, x1:number, x2:number)
.decl jn32(x0:number, x1:number, x2:number)
.decl jn33(x0:number, x1:number)
.decl k_34(x0:number, x1:number)
.decl kv35(x0:number, x1:number, x2:number)
.decl jn36(x0:number, x1:number)
.decl jn37(x0:number, x1:number)
.decl jn38(x0:number, x1:number)
.decl jn39(x0:number, x1:number, x2:number)
.decl jn40(x0:number, x1:number, x2:number, x3:number)
.decl jn41(x0:number, x1:number, x2:number, x3:number)
.decl jn42(x0:number, x1:number)
.decl kv43(x0:number, x1:number)
.decl jn44(x0:number, x1:number)
.decl kv45(x0:number, x1:number, x2:number)
.decl jn46(x0:number, x1:number)
.decl jn47(x0:number, x1:number)
.decl kv48(x0:number, x1:number)
.decl kv49(x0:number, x1:number, x2:number)
.decl jn50(x0:number, x1:number)
.decl jn51(x0:number, x1:number)
.decl kv52(x0:number, x1:number)
.decl kv53(x0:number, x1:number)
.decl kv54(x0:number, x1:number)
.decl kv55(x0:number, x1:number)
.decl jn56(x0:number)
.decl jn57(x0:number, x1:number)
.decl jn58(x0:number, x1:number)
.decl jn59(x0:number, x1:number)
.decl jn60(x0:number, x1:number)
.decl kv61(x0:number, x1:number, x2:number, x3:number)
.decl kv62(x0:number, x1:number)
.decl kv63(x0:number, x1:number)
.decl kv64(x0:number, x1:number)
.decl jn65(x0:number, x1:number)
.decl jn66(x0:number, x1:number)
.decl jn67(x0:number, x1:number, x2:number)
.decl jn68(x0:number, x1:number, x2:number, x3:number)
.decl jn69(x0:number, x1:number, x2:number, x3:number)
.decl jn70(x0:number, x1:number)
.decl jn71(x0:number, x1:number)
.decl kv72(x0:number, x1:number, x2:number)
.decl jn73(x0:number, x1:number)
.decl jn74(x0:number, x1:number)

.output VarPointsTo

// strata #0
kv0(inMethod, heap, var) :- AssignHeapAllocation(heap, var, inMethod).
k_1(inMethod) :- Reachable(inMethod).
VarPointsTo(heap, var) :- kv0(inMethod, heap, var), k_1(inMethod).

// strata #1 (recursive)
k_3(heap, from) :- VarPointsTo(heap, from).
kv4(heaptype, heap) :- HeapAllocation_Type(heap, heaptype).
kv5(type, heaptype) :- SupertypeOf(type, heaptype).
kv6(inmethod, type, from, to) :- AssignCast(type, from, to, inmethod).
jn7(type, from, to) :- kv6(inmethod, type, from, to), k_1(inmethod).
jn8(heaptype, from, to) :- kv5(type, heaptype), jn7(type, from, to).
jn9(heap, from, to) :- kv4(heaptype, heap), jn8(heaptype, from, to).
VarPointsTo(heap, to) :- k_3(heap, from), jn9(heap, from, to).
k_11(basecomponenttype, type) :- SupertypeOf(type, basecomponenttype).
kv12(baseheaptype, basecomponenttype) :- ComponentType(baseheaptype, basecomponenttype).
kv13(baseheap, baseheaptype) :- HeapAllocation_Type(baseheap, baseheaptype).
kv14(to, type) :- Var_Type(to, type).
kv15(baseheap, heap) :- ArrayIndexPointsTo(baseheap, heap).
kv16(base, baseheap) :- VarPointsTo(baseheap, base).
kv17(inmethod, base, to) :- LoadArrayIndex(base, to, inmethod).
jn18(base, to) :- kv17(inmethod, base, to), k_1(inmethod).
jn19(baseheap, to) :- kv16(base, baseheap), jn18(base, to).
jn20(to, baseheap, heap) :- kv15(baseheap, heap), jn19(baseheap, to).
jn21(baseheap, to, type, heap) :- kv14(to, type), jn20(to, baseheap, heap).
jn22(baseheaptype, to, type, heap) :- kv13(baseheap, baseheaptype), jn21(baseheap, to, type, heap).
jn23(basecomponenttype, type, to, heap) :- kv12(baseheaptype, basecomponenttype), jn22(baseheaptype, to, type, heap).
VarPointsTo(heap, to) :- k_11(basecomponenttype, type), jn23(basecomponenttype, type, to, heap).
kv25(inmethod, from, base, fld) :- StoreInstanceField(from, base, fld, inmethod).
jn26(from, base, fld) :- kv25(inmethod, from, base, fld), k_1(inmethod).
jn27(base, heap, fld) :- kv16(from, heap), jn26(from, base, fld).
InstanceFieldPointsTo(heap, fld, baseheap) :- kv16(base, baseheap), jn27(base, heap, fld).
kv29(baseheap, signature, heap) :- InstanceFieldPointsTo(heap, signature, baseheap).
kv30(inmethod, base, signature, to) :- LoadInstanceField(base, signature, to, inmethod).
jn31(base, signature, to) :- kv30(inmethod, base, signature, to), k_1(inmethod).
jn32(baseheap, signature, to) :- kv16(base, baseheap), jn31(base, signature, to).
VarPointsTo(heap, to) :- kv29(baseheap, signature, heap), jn32(baseheap, signature, to).
k_34(componenttype, heaptype) :- SupertypeOf(componenttype, heaptype).
kv35(inmethod, base, from) :- StoreArrayIndex(from, base, inmethod).
jn36(base, from) :- kv35(inmethod, base, from), k_1(inmethod).
jn37(from, baseheap) :- kv16(base, baseheap), jn36(base, from).
jn38(heap, baseheap) :- kv16(from, heap), jn37(from, baseheap).
jn39(baseheap, heap, heaptype) :- kv13(heap, heaptype), jn38(heap, baseheap).
jn40(baseheaptype, baseheap, heap, heaptype) :- kv13(baseheap, baseheaptype), jn39(baseheap, heap, heaptype).
jn41(componenttype, heaptype, baseheap, heap) :- kv12(baseheaptype, componenttype), jn40(baseheaptype, baseheap, heap, heaptype).
ArrayIndexPointsTo(baseheap, heap) :- k_34(componenttype, heaptype), jn41(componenttype, heaptype, baseheap, heap).
kv43(from, to) :- Assign(from, to).
VarPointsTo(heap, to) :- kv16(from, heap), kv43(from, to).
kv45(inmethod, from, fld) :- StoreStaticField(from, fld, inmethod).
jn46(from, fld) :- kv45(inmethod, from, fld), k_1(inmethod).
StaticFieldPointsTo(heap, fld) :- kv16(from, heap), jn46(from, fld).
kv48(fld, heap) :- StaticFieldPointsTo(heap, fld).
kv49(inmethod, fld, to) :- LoadStaticField(fld, to, inmethod).
jn50(fld, to) :- kv49(inmethod, fld, to), k_1(inmethod).
VarPointsTo(heap, to) :- kv48(fld, heap), jn50(fld, to).
kv52(tomethod, this) :- ThisVar(tomethod, this).
kv53(invocation, tomethod) :- MethodInvocation_Method(invocation, tomethod).
kv54(invocation, base) :- SpecialMethodInvocation_Base(invocation, base).
kv55(inmethod, invocation) :- Instruction_Method(invocation, inmethod).
jn56(invocation) :- kv55(inmethod, invocation), k_1(inmethod).
jn57(base, invocation) :- kv54(invocation, base), jn56(invocation).
jn58(invocation, heap) :- kv16(base, heap), jn57(base, invocation).
jn59(tomethod, heap) :- kv53(invocation, tomethod), jn58(invocation, heap).
VarPointsTo(heap, this) :- kv52(tomethod, this), jn59(tomethod, heap).
kv61(descriptor, simplename, heaptype, toMethod) :- MethodLookup(simplename, descriptor, heaptype, toMethod).
kv62(invocation, descriptor) :- VirtualMethodInvocation_Descriptor(invocation, descriptor).
kv63(invocation, simplename) :- VirtualMethodInvocation_SimpleName(invocation, simplename).
kv64(invocation, base) :- VirtualMethodInvocation_Base(invocation, base).
jn65(base, invocation) :- kv64(invocation, base), jn56(invocation).
jn66(heap, invocation) :- kv16(base, heap), jn65(base, invocation).
jn67(invocation, heap, heaptype) :- kv13(heap, heaptype), jn66(heap, invocation).
jn68(invocation, simplename, heap, heaptype) :- kv63(invocation, simplename), jn67(invocation, heap, heaptype).
jn69(descriptor, simplename, heaptype, heap) :- kv62(invocation, descriptor), jn68(invocation, simplename, heap, heaptype).
jn70(toMethod, heap) :- kv61(descriptor, simplename, heaptype, toMethod), jn69(descriptor, simplename, heaptype, heap).
VarPointsTo(heap, this) :- kv52(toMethod, this), jn70(toMethod, heap).
kv72(inmethod, from, to) :- AssignLocal(from, to, inmethod).
jn73(from, to) :- kv72(inmethod, from, to), k_1(inmethod).
VarPointsTo(heap, to) :- kv16(from, heap), jn73(from, to).