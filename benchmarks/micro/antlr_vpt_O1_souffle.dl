.decl VarPointsTo_sip4f1(x0:number, x1:number)
.decl ArrayIndexPointsTo_sip4f2(x0:number, x1:number)
.decl Var_Type_sip4f3(x0:number, x1:number)
.decl HeapAllocation_Type_sip4f4(x0:number, x1:number)
.decl ComponentType_sip4f5(x0:number, x1:number)
.decl SupertypeOf_sip4f6(x0:number, x1:number)
