.decl Instruction_Method_sip5f0_sip5b4(x0:number, x1:number)
.decl StoreInstanceField_sip6f0(x0:number, x1:number, x2:number, x3:number)
.decl VarPointsTo_sip6f1(x0:number, x1:number)
