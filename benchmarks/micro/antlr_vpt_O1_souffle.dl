.decl Reachable(method:number)
.decl Assign(to:number, from:number)
.decl AssignHeapAllocation(heap:number, to:number, inmethod:number)
.decl AssignLocal(from:number, to:number, inmethod:number)
.decl AssignCast(type:number, from:number, to:number, inmethod:number)
.decl SupertypeOf(supertype:number, type:number)
.decl HeapAllocation_Type(heap:number, type:number)
.decl StoreArrayIndex(from:number, base:number, inmethod:number)
.decl ComponentType(arrayType:number, componentType:number)
.decl LoadArrayIndex(base:number, to:number, inmethod:number)
.decl Var_Type(var:number, type:number)
.decl LoadInstanceField(base:number, sig:number, to:number, inmethod:number)
.decl StoreInstanceField(from:number, base:number, signature:number, inmethod:number)
.decl LoadStaticField(sig:number, to:number, inmethod:number)
.decl StoreStaticField(from:number, signature:number, inmethod:number)
.decl Instruction_Method(insn:number, inMethod:number)
.decl VirtualMethodInvocation_Base(invocation:number, base:number)
.decl VirtualMethodInvocation_SimpleName(invocation:number, simplename:number)
.decl VirtualMethodInvocation_Descriptor(invocation:number, descriptor:number)
.decl MethodLookup(simplename:number, descriptor:number, type:number, method:number)
.decl ThisVar(method:number, var:number)
.decl SpecialMethodInvocation_Base(invocation:number, base:number)
.decl MethodInvocation_Method(invocation:number, signature:number)
.input Reachable(IO=file, filename="Reachable.csv", delimiter=",")
.input Assign(IO=file, filename="Assign.csv", delimiter=",")
.input AssignHeapAllocation(IO=file, filename="AssignHeapAllocation.csv", delimiter=",")
.input AssignLocal(IO=file, filename="AssignLocal.csv", delimiter=",")
.input AssignCast(IO=file, filename="AssignCast.csv", delimiter=",")
.input SupertypeOf(IO=file, filename="SupertypeOf.csv", delimiter=",")
.input HeapAllocation_Type(IO=file, filename="HeapAllocation_Type.csv", delimiter=",")
.input StoreArrayIndex(IO=file, filename="StoreArrayIndex.csv", delimiter=",")
.input ComponentType(IO=file, filename="ComponentType.csv", delimiter=",")
.input LoadArrayIndex(IO=file, filename="LoadArrayIndex.csv", delimiter=",")
.input Var_Type(IO=file, filename="Var_Type.csv", delimiter=",")
.input LoadInstanceField(IO=file, filename="LoadInstanceField.csv", delimiter=",")
.input StoreInstanceField(IO=file, filename="StoreInstanceField.csv", delimiter=",")
.input LoadStaticField(IO=file, filename="LoadStaticField.csv", delimiter=",")
.input StoreStaticField(IO=file, filename="StoreStaticField.csv", delimiter=",")
.input Instruction_Method(IO=file, filename="Instruction_Method.csv", delimiter=",")
.input VirtualMethodInvocation_Base(IO=file, filename="VirtualMethodInvocation_Base.csv", delimiter=",")
.input VirtualMethodInvocation_SimpleName(IO=file, filename="VirtualMethodInvocation_SimpleName.csv", delimiter=",")
.input VirtualMethodInvocation_Descriptor(IO=file, filename="VirtualMethodInvocation_Descriptor.csv", delimiter=",")
.input MethodLookup(IO=file, filename="MethodLookup.csv", delimiter=",")
.input ThisVar(IO=file, filename="ThisVar.csv", delimiter=",")
.input SpecialMethodInvocation_Base(IO=file, filename="SpecialMethodInvocation_Base.csv", delimiter=",")
.input MethodInvocation_Method(IO=file, filename="MethodInvocation_Method.csv", delimiter=",")


// IDBs
.decl VarPointsTo(x0:number, x1:number)
.decl StaticFieldPointsTo(x0:number, x1:number)
.decl LoadInstanceField_sip2f0(x0:number, x1:number, x2:number, x3:number)
.decl VarPointsTo_sip2f1(x0:number, x1:number)
.decl InstanceFieldPointsTo_sip2f2(x0:number, x1:number, x2:number)
.decl VarPointsTo_sip2f1_sip2b1(x0:number, x1:number)
.decl LoadInstanceField_sip2f0_sip2b2(x0:number, x1:number, x2:number, x3:number)
.decl StoreArrayIndex_sip3f0(x0:number, x1:number, x2:number)
.decl VarPointsTo_sip3f1(x0:number, x1:number)
