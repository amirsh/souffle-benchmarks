StrLit0(ind) :- Global_String_Dictionary("static", ind).
StrLit2(ind) :- Global_String_Dictionary("<<main method array>>", ind).
StrLit4(ind) :- Global_String_Dictionary("void()", ind).
StrLit5(ind) :- Global_String_Dictionary("abstract", ind).
StrLit6(ind) :- Global_String_Dictionary("<sun.security.provider.PolicyParser: void main(java.lang.String[])>", ind).
StrLit7(ind) :- Global_String_Dictionary("<java.util.prefs.Base64: void main(java.lang.String[])>", ind).
StrLit8(ind) :- Global_String_Dictionary("public", ind).
StrLit9(ind) :- Global_String_Dictionary("main", ind).
StrLit10(ind) :- Global_String_Dictionary("java.lang.String[]", ind).
StrLit11(ind) :- Global_String_Dictionary("<<main method array content>>", ind).
StrLit12(ind) :- Global_String_Dictionary("void(java.lang.String[])", ind).
StrLit13(ind) :- Global_String_Dictionary("<clinit>", ind).
StrLit15(ind) :- Global_String_Dictionary("java.lang.String", ind).
StrLit16(ind) :- Global_String_Dictionary("<sun.java2d.loops.GraphicsPrimitiveMgr: void main(java.lang.String[])>", ind).
HeapAllocation_Type(?id_h, ?type_h) :- _NormalHeap_interned(?id_h, ?type_h).
HeapAllocation_Type(?id_h, arg_2_h) :- _StringConstant_interned(?id_h), StrLit15(arg_2_h).
Instruction_Method(?instruction_h, ?method_h) :- _AssignHeapAllocation_interned(?instruction_h, _, ?heap_h, ?to_h, ?method_h, _).
AssignInstruction_To(?instruction_h, ?to_h) :- _AssignHeapAllocation_interned(?instruction_h, _, ?heap_h, ?to_h, ?method_h, _).
AssignHeapAllocation_Heap(?instruction_h, ?heap_h) :- _AssignHeapAllocation_interned(?instruction_h, _, ?heap_h, ?to_h, ?method_h, _).
Instruction_Method(?instruction_h, ?method_h) :- _AssignLocal_interned(?instruction_h, _, ?from_h, ?to_h, ?method_h).
AssignLocal_From(?instruction_h, ?from_h) :- _AssignLocal_interned(?instruction_h, _, ?from_h, ?to_h, ?method_h).
AssignInstruction_To(?instruction_h, ?to_h) :- _AssignLocal_interned(?instruction_h, _, ?from_h, ?to_h, ?method_h).
Instruction_Method(?instruction_h, ?method_h) :- _AssignCast_interned(?instruction_h, _, ?from_h, ?to_h, ?type_h, ?method_h).
AssignInstruction_To(?instruction_h, ?to_h) :- _AssignCast_interned(?instruction_h, _, ?from_h, ?to_h, ?type_h, ?method_h).
Field_DeclaringType(?signature_h, ?declaringType_h) :- _Field_interned(?signature_h, ?declaringType_h, _, _).
Instruction_Method(?instruction_h, ?method_h) :- _StaticMethodInvocation_interned(?instruction_h, _, ?signature_h, ?method_h).
isStaticMethodInvocation_Insn(?instruction_h) :- _StaticMethodInvocation_interned(?instruction_h, _, ?signature_h, ?method_h).
MethodInvocation_Method(?instruction_h, ?signature_h) :- _StaticMethodInvocation_interned(?instruction_h, _, ?signature_h, ?method_h).
Instruction_Method(?instruction_h, ?method_h) :- _SpecialMethodInvocation_interned(?instruction_h, _, ?signature_h, ?base_h, ?method_h).
MethodInvocation_Method(?instruction_h, ?signature_h) :- _SpecialMethodInvocation_interned(?instruction_h, _, ?signature_h, ?base_h, ?method_h).
Instruction_Method(?instruction_h, ?method_h) :- _VirtualMethodInvocation_interned(?instruction_h, _, ?signature_h, ?base_h, ?method_h).
MethodInvocation_Method(?instruction_h, ?signature_h) :- _VirtualMethodInvocation_interned(?instruction_h, _, ?signature_h, ?base_h, ?method_h).
Method_SimpleName(?method_h, ?simplename_h) :- _Method_interned(?method_h, ?simplename_h, ?params_h, ?declaringType_h, ?returnType_h, _, _).
Method_DeclaringType(?method_h, ?declaringType_h) :- _Method_interned(?method_h, ?simplename_h, ?params_h, ?declaringType_h, ?returnType_h, _, _).
Method_Descriptor(?method_h, ?descriptor_h) :- _Method_Descriptor_interned(?method_h, ?descriptor_h).
Instruction_Method(?instruction_h, ?method_h) :- _StoreInstanceField_interned(?instruction_h, _, ?from_h, ?base_h, ?signature_h, ?method_h).
FieldInstruction_Signature(?instruction_h, ?signature_h) :- _StoreInstanceField_interned(?instruction_h, _, ?from_h, ?base_h, ?signature_h, ?method_h).
Instruction_Method(?instruction_h, ?method_h) :- _LoadInstanceField_interned(?instruction_h, _, ?to_h, ?base_h, ?signature_h, ?method_h).
FieldInstruction_Signature(?instruction_h, ?signature_h) :- _LoadInstanceField_interned(?instruction_h, _, ?to_h, ?base_h, ?signature_h, ?method_h).
Instruction_Method(?instruction_h, ?method_h) :- _StoreStaticField_interned(?instruction_h, _, ?from_h, ?signature_h, ?method_h).
FieldInstruction_Signature(?instruction_h, ?signature_h) :- _StoreStaticField_interned(?instruction_h, _, ?from_h, ?signature_h, ?method_h).
StoreStaticField_From(?instruction_h, ?from_h) :- _StoreStaticField_interned(?instruction_h, _, ?from_h, ?signature_h, ?method_h).
Instruction_Method(?instruction_h, ?method_h) :- _LoadStaticField_interned(?instruction_h, _, ?to_h, ?signature_h, ?method_h).
FieldInstruction_Signature(?instruction_h, ?signature_h) :- _LoadStaticField_interned(?instruction_h, _, ?to_h, ?signature_h, ?method_h).
LoadStaticField_To(?instruction_h, ?to_h) :- _LoadStaticField_interned(?instruction_h, _, ?to_h, ?signature_h, ?method_h).
Instruction_Method(?instruction_h, ?method_h) :- _StoreArrayIndex_interned(?instruction_h, _, ?from_h, ?base_h, ?method_h).
Instruction_Method(?instruction_h, ?method_h) :- _LoadArrayIndex_interned(?instruction_h, _, ?to_h, ?base_h, ?method_h).
Instruction_Method(?instruction_h, ?method_h) :- _Return_interned(?instruction_h, _, ?var_h, ?method_h).
ReturnNonvoid_Var(?instruction_h, ?var_h) :- _Return_interned(?instruction_h, _, ?var_h, ?method_h).
LoadStaticField(?sig_h, ?to_h, ?inmethod_h) :- Instruction_Method(?insn_h, ?inmethod_h), FieldInstruction_Signature(?insn_h, ?sig_h), LoadStaticField_To(?insn_h, ?to_h).
StoreStaticField(?from_h, ?sig_h, ?inmethod_h) :- Instruction_Method(?insn_h, ?inmethod_h), StoreStaticField_From(?insn_h, ?from_h), FieldInstruction_Signature(?insn_h, ?sig_h).
AssignLocal(?from_h, ?to_h, ?inmethod_h) :- AssignInstruction_To(?insn_h, ?to_h), Instruction_Method(?insn_h, ?inmethod_h), AssignLocal_From(?insn_h, ?from_h).
AssignHeapAllocation(?heap_h, ?to_h, ?inmethod_h) :- Instruction_Method(?insn_h, ?inmethod_h), AssignHeapAllocation_Heap(?insn_h, ?heap_h), AssignInstruction_To(?insn_h, ?to_h).
ReturnVar(?var_h, ?method_h) :- Instruction_Method(?insn_h, ?method_h), ReturnNonvoid_Var(?insn_h, ?var_h).
StaticMethodInvocation(?invocation_h, ?signature_h, ?inmethod_h) :- isStaticMethodInvocation_Insn(?invocation_h), Instruction_Method(?invocation_h, ?inmethod_h), MethodInvocation_Method(?invocation_h, ?signature_h).
HeapAllocation_Type(?heap_h, ?type_h) :- StrLit2(?heap_h), StrLit10(?type_h).
HeapAllocation_Type(?heap_h, ?type_h) :- StrLit11(?heap_h), StrLit15(?type_h).
MethodImplemented(?simplename_h, ?descriptor_h, ?type_h, ?method_h) :- Method_SimpleName(?method_h, ?simplename_h), Method_Descriptor(?method_h, ?descriptor_h), Method_DeclaringType(?method_h, ?type_h), StrLit5(__ind5), !Method_Modifier_interned(__ind5, ?method_h).
MainMethodDeclaration(?method_h) :- MainClass_interned(?type_h), Method_DeclaringType(?method_h, ?type_h), !StrLit7(?method_h), !StrLit16(?method_h), !StrLit6(?method_h), StrLit9(__ind9), Method_SimpleName(?method_h, __ind9), StrLit12(__ind12), Method_Descriptor(?method_h, __ind12), StrLit8(__ind8), Method_Modifier_interned(__ind8, ?method_h), StrLit0(__ind0), Method_Modifier_interned(__ind0, ?method_h).
ClassInitializer(?type_h, ?method_h) :- StrLit13(__ind13), StrLit4(__ind4), MethodImplemented(__ind13, __ind4, ?type_h, ?method_h).
InitializedClass(?superclass_h) :- InitializedClass(?class_h), DirectSuperclass_interned(?class_h, ?superclass_h).
InitializedClass(?superinterface_h) :- InitializedClass(?classOrInterface_h), DirectSuperinterface_interned(?classOrInterface_h, ?superinterface_h).
InitializedClass(?class_h) :- MainMethodDeclaration(?method_h), Method_DeclaringType(?method_h, ?class_h).
InitializedClass(?class_h) :- Reachable(?inmethod_h), AssignHeapAllocation(?heap_h, _, ?inmethod_h), HeapAllocation_Type(?heap_h, ?class_h).
InitializedClass(?class_h) :- Reachable(?inmethod_h), Instruction_Method(?invocation_h, ?inmethod_h), isStaticMethodInvocation_Insn(?invocation_h), MethodInvocation_Method(?invocation_h, ?signature_h), Method_DeclaringType(?signature_h, ?class_h).
InitializedClass(?classOrInterface_h) :- Reachable(?inmethod_h), StoreStaticField(_, ?signature_h, ?inmethod_h), Field_DeclaringType(?signature_h, ?classOrInterface_h).
InitializedClass(?classOrInterface_h) :- Reachable(?inmethod_h), LoadStaticField(?signature_h, _, ?inmethod_h), Field_DeclaringType(?signature_h, ?classOrInterface_h).
Reachable(?clinit_h) :- InitializedClass(?class_h), ClassInitializer(?class_h, ?clinit_h).
Assign(?actual_h, ?formal_h) :- CallGraphEdge(?invocation_h, ?method_h), FormalParam_interned(?index, ?method_h, ?formal_h), ActualParam_interned(?index, ?invocation_h, ?actual_h).
Assign(?return_h, ?local_h) :- CallGraphEdge(?invocation_h, ?method_h), ReturnVar(?return_h, ?method_h), AssignReturnValue_interned(?invocation_h, ?local_h).
VarPointsTo(?heap_h, ?var_h) :- AssignHeapAllocation(?heap_h, ?var_h, ?inMethod_h), Reachable(?inMethod_h).
VarPointsTo(?heap_h, ?to_h) :- Assign(?from_h, ?to_h), VarPointsTo(?heap_h, ?from_h).
VarPointsTo(?heap_h, ?to_h) :- Reachable(?inmethod_h), AssignLocal(?from_h, ?to_h, ?inmethod_h), VarPointsTo(?heap_h, ?from_h).
Reachable(?tomethod_h) :- Reachable(?inmethod_h), StaticMethodInvocation(?invocation_h, ?tomethod_h, ?inmethod_h).
CallGraphEdge(?invocation_h, ?tomethod_h) :- Reachable(?inmethod_h), StaticMethodInvocation(?invocation_h, ?tomethod_h, ?inmethod_h).
Reachable(?method_h) :- MainMethodDeclaration(?method_h).
