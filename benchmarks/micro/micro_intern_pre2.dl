.decl _LoadStaticField_interned(?instruction_h: number, ?index: number, ?to_h: number, ?signature_h: number, ?method_h: number)
.decl _StoreArrayIndex_interned(?instruction_h: number, ?index: number, ?from_h: number, ?base_h: number, ?method_h: number)
.decl _LoadArrayIndex_interned(?instruction_h: number, ?index: number, ?to_h: number, ?base_h: number, ?method_h: number)
.decl _Return_interned(?instruction_h: number, ?index: number, ?var_h: number, ?method_h: number)
