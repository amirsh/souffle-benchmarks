.decl _ThisVar_interned(?method_h: number, ?var_h: number)
.decl _NormalHeap_interned(?id_h: number, ?type_h: number)
.decl _StringConstant_interned(?id_h: number)
.decl _AssignHeapAllocation_interned(?instruction_h: number, ?index: number, ?heap_h: number, ?to_h: number, ?inmethod_h: number, ?linenumber: number)
.decl _AssignLocal_interned(?instruction_h: number, ?index: number, ?from_h: number, ?to_h: number, ?inmethod_h: number)
.decl _AssignCast_interned(?instruction_h: number, ?index: number, ?from_h: number, ?to_h: number, ?type_h: number, ?inmethod_h: number)
.decl _Field_interned(?signature_h: number, ?declaringClass_h: number, ?simplename_h: number, ?type_h: number)
.decl _StaticMethodInvocation_interned(?instruction_h: number, ?index: number, ?signature_h: number, ?method_h: number)
.decl _SpecialMethodInvocation_interned(?instruction_h: number, ?index: number, ?signature_h: number, ?base_h: number, ?method_h: number)
.decl _VirtualMethodInvocation_interned(?instruction_h: number, ?index: number, ?signature_h: number, ?base_h: number, ?method_h: number)
.decl _Method_interned(?method_h: number, ?simplename_h: number, ?descriptor_h: number, ?declaringType_h: number, ?returnType_h: number, ?jvmDescriptor_h: number, ?arity: number)
