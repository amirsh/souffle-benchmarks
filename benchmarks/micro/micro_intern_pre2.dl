.decl _StoreInstanceField_interned(?instruction_h: number, ?index: number, ?from_h: number, ?base_h: number, ?signature_h: number, ?method_h: number)
.decl _LoadInstanceField_interned(?instruction_h: number, ?index: number, ?to_h: number, ?base_h: number, ?signature_h: number, ?method_h: number)
