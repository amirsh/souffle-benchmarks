DirectSuperclass_interned(?class_h, ?superclass_h) :- DirectSuperclass(?class, ?superclass), Global_String_Dictionary(?class, ?class_h), Global_String_Dictionary(?superclass, ?superclass_h).
DirectSuperinterface_interned(?ref_h, ?interface_h) :- DirectSuperinterface(?ref, ?interface), Global_String_Dictionary(?ref, ?ref_h), Global_String_Dictionary(?interface, ?interface_h).
MainClass_interned(?class_h) :- MainClass(?class), Global_String_Dictionary(?class, ?class_h).
Method_Modifier_interned(?mod_h, ?method_h) :- Method_Modifier(?mod, ?method), Global_String_Dictionary(?mod, ?mod_h), Global_String_Dictionary(?method, ?method_h).
FormalParam_interned(?index, ?method_h, ?var_h) :- FormalParam(?index, ?method, ?var), Global_String_Dictionary(?method, ?method_h), Global_String_Dictionary(?var, ?var_h).
Var_Type_interned(?var_h, ?type_h) :- Var_Type(?var, ?type), Global_String_Dictionary(?var, ?var_h), Global_String_Dictionary(?type, ?type_h).
ComponentType_interned(?arrayType_h, ?componentType_h) :- ComponentType(?arrayType, ?componentType), Global_String_Dictionary(?arrayType, ?arrayType_h), Global_String_Dictionary(?componentType, ?componentType_h).
AssignReturnValue_interned(?invocation_h, ?to_h) :- AssignReturnValue(?invocation, ?to), Global_String_Dictionary(?invocation, ?invocation_h), Global_String_Dictionary(?to, ?to_h).
ActualParam_interned(?index, ?invocation_h, ?var_h) :- ActualParam(?index, ?invocation, ?var), Global_String_Dictionary(?invocation, ?invocation_h), Global_String_Dictionary(?var, ?var_h).
_ClassType_interned(?class_h) :- _ClassType(?class), Global_String_Dictionary(?class, ?class_h).
_ArrayType_interned(?arrayType_h) :- _ArrayType(?arrayType), Global_String_Dictionary(?arrayType, ?arrayType_h).
_InterfaceType_interned(?interface_h) :- _InterfaceType(?interface), Global_String_Dictionary(?interface, ?interface_h).
_Var_DeclaringMethod_interned(?var_h, ?method_h) :- _Var_DeclaringMethod(?var, ?method), Global_String_Dictionary(?var, ?var_h), Global_String_Dictionary(?method, ?method_h).
_ApplicationClass_interned(?type_h) :- _ApplicationClass(?type), Global_String_Dictionary(?type, ?type_h).
_ThisVar_interned(?method_h, ?var_h) :- _ThisVar(?method, ?var), Global_String_Dictionary(?method, ?method_h), Global_String_Dictionary(?var, ?var_h).
_NormalHeap_interned(?id_h, ?type_h) :- _NormalHeap(?id, ?type), Global_String_Dictionary(?id, ?id_h), Global_String_Dictionary(?type, ?type_h).
_StringConstant_interned(?id_h) :- _StringConstant(?id), Global_String_Dictionary(?id, ?id_h).
_AssignHeapAllocation_interned(?instruction_h, ?index, ?heap_h, ?to_h, ?inmethod_h, ?linenumber) :- _AssignHeapAllocation(?instruction, ?index, ?heap, ?to, ?inmethod, ?linenumber), Global_String_Dictionary(?instruction, ?instruction_h), Global_String_Dictionary(?heap, ?heap_h), Global_String_Dictionary(?to, ?to_h), Global_String_Dictionary(?inmethod, ?inmethod_h).
_AssignLocal_interned(?instruction_h, ?index, ?from_h, ?to_h, ?inmethod_h) :- _AssignLocal(?instruction, ?index, ?from, ?to, ?inmethod), Global_String_Dictionary(?instruction, ?instruction_h), Global_String_Dictionary(?from, ?from_h), Global_String_Dictionary(?to, ?to_h), Global_String_Dictionary(?inmethod, ?inmethod_h).
_AssignCast_interned(?instruction_h, ?index, ?from_h, ?to_h, ?type_h, ?inmethod_h) :- _AssignCast(?instruction, ?index, ?from, ?to, ?type, ?inmethod), Global_String_Dictionary(?instruction, ?instruction_h), Global_String_Dictionary(?from, ?from_h), Global_String_Dictionary(?to, ?to_h), Global_String_Dictionary(?type, ?type_h), Global_String_Dictionary(?inmethod, ?inmethod_h).
_Field_interned(?signature_h, ?declaringClass_h, ?simplename_h, ?type_h) :- _Field(?signature, ?declaringClass, ?simplename, ?type), Global_String_Dictionary(?signature, ?signature_h), Global_String_Dictionary(?declaringClass, ?declaringClass_h), Global_String_Dictionary(?simplename, ?simplename_h), Global_String_Dictionary(?type, ?type_h).
_StaticMethodInvocation_interned(?instruction_h, ?index, ?signature_h, ?method_h) :- _StaticMethodInvocation(?instruction, ?index, ?signature, ?method), Global_String_Dictionary(?instruction, ?instruction_h), Global_String_Dictionary(?signature, ?signature_h), Global_String_Dictionary(?method, ?method_h).
_SpecialMethodInvocation_interned(?instruction_h, ?index, ?signature_h, ?base_h, ?method_h) :- _SpecialMethodInvocation(?instruction, ?index, ?signature, ?base, ?method), Global_String_Dictionary(?instruction, ?instruction_h), Global_String_Dictionary(?signature, ?signature_h), Global_String_Dictionary(?base, ?base_h), Global_String_Dictionary(?method, ?method_h).
_VirtualMethodInvocation_interned(?instruction_h, ?index, ?signature_h, ?base_h, ?method_h) :- _VirtualMethodInvocation(?instruction, ?index, ?signature, ?base, ?method), Global_String_Dictionary(?instruction, ?instruction_h), Global_String_Dictionary(?signature, ?signature_h), Global_String_Dictionary(?base, ?base_h), Global_String_Dictionary(?method, ?method_h).
_Method_interned(?method_h, ?simplename_h, ?descriptor_h, ?declaringType_h, ?returnType_h, ?jvmDescriptor_h, ?arity) :- _Method(?method, ?simplename, ?descriptor, ?declaringType, ?returnType, ?jvmDescriptor, ?arity), Global_String_Dictionary(?method, ?method_h), Global_String_Dictionary(?simplename, ?simplename_h), Global_String_Dictionary(?descriptor, ?descriptor_h), Global_String_Dictionary(?declaringType, ?declaringType_h), Global_String_Dictionary(?returnType, ?returnType_h), Global_String_Dictionary(?jvmDescriptor, ?jvmDescriptor_h).
_Method_Descriptor_interned(?method_h, ?descriptor_h) :- _Method_Descriptor(?method, ?descriptor), Global_String_Dictionary(?method, ?method_h), Global_String_Dictionary(?descriptor, ?descriptor_h).
_StoreInstanceField_interned(?instruction_h, ?index, ?from_h, ?base_h, ?signature_h, ?method_h) :- _StoreInstanceField(?instruction, ?index, ?from, ?base, ?signature, ?method), Global_String_Dictionary(?instruction, ?instruction_h), Global_String_Dictionary(?from, ?from_h), Global_String_Dictionary(?base, ?base_h), Global_String_Dictionary(?signature, ?signature_h), Global_String_Dictionary(?method, ?method_h).
_LoadInstanceField_interned(?instruction_h, ?index, ?to_h, ?base_h, ?signature_h, ?method_h) :- _LoadInstanceField(?instruction, ?index, ?to, ?base, ?signature, ?method), Global_String_Dictionary(?instruction, ?instruction_h), Global_String_Dictionary(?to, ?to_h), Global_String_Dictionary(?base, ?base_h), Global_String_Dictionary(?signature, ?signature_h), Global_String_Dictionary(?method, ?method_h).
_StoreStaticField_interned(?instruction_h, ?index, ?from_h, ?signature_h, ?method_h) :- _StoreStaticField(?instruction, ?index, ?from, ?signature, ?method), Global_String_Dictionary(?instruction, ?instruction_h), Global_String_Dictionary(?from, ?from_h), Global_String_Dictionary(?signature, ?signature_h), Global_String_Dictionary(?method, ?method_h).
_LoadStaticField_interned(?instruction_h, ?index, ?to_h, ?signature_h, ?method_h) :- _LoadStaticField(?instruction, ?index, ?to, ?signature, ?method), Global_String_Dictionary(?instruction, ?instruction_h), Global_String_Dictionary(?to, ?to_h), Global_String_Dictionary(?signature, ?signature_h), Global_String_Dictionary(?method, ?method_h).
_StoreArrayIndex_interned(?instruction_h, ?index, ?from_h, ?base_h, ?method_h) :- _StoreArrayIndex(?instruction, ?index, ?from, ?base, ?method), Global_String_Dictionary(?instruction, ?instruction_h), Global_String_Dictionary(?from, ?from_h), Global_String_Dictionary(?base, ?base_h), Global_String_Dictionary(?method, ?method_h).
_LoadArrayIndex_interned(?instruction_h, ?index, ?to_h, ?base_h, ?method_h) :- _LoadArrayIndex(?instruction, ?index, ?to, ?base, ?method), Global_String_Dictionary(?instruction, ?instruction_h), Global_String_Dictionary(?to, ?to_h), Global_String_Dictionary(?base, ?base_h), Global_String_Dictionary(?method, ?method_h).
_Return_interned(?instruction_h, ?index, ?var_h, ?method_h) :- _Return(?instruction, ?index, ?var, ?method), Global_String_Dictionary(?instruction, ?instruction_h), Global_String_Dictionary(?var, ?var_h), Global_String_Dictionary(?method, ?method_h).